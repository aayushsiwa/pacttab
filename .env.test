# Test environment — loaded automatically by tests/setup.ts before any test file.
# Keep these values isolated: a dedicated test database and a separate Redis index,
# so running the suite never reads or writes development or production data.
# The database is created (with migrations) before the run and dropped afterwards.
DATABASE_URL="postgresql://unocade:secret@127.0.0.1:5432/pacttab_test"
SESSION_SECRET="pacttab-test-secret-key-change-in-production-min-32-chars"
BETTER_AUTH_SECRET="pacttab-test-secret-key-change-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REDIS_URL="redis://default@127.0.0.1:6379/1"
